# RA -- Renewable AI Decision Engine
# Copy this file to .env and fill in values only if you want to enable an
# optional feature. The application is fully functional with NO .env file
# at all -- every value below is optional and defaults to "disabled".

# --- Optional: RA Assistant LLM wording adapter (Part 6) -------------------
# The RA Assistant (POST /assistant/query) always produces a deterministic,
# offline, fully grounded answer first -- these variables only enable an
# OPTIONAL rewrite pass that rephrases that answer for more natural wording.
# The LLM is never allowed to change numbers, facts, or the recommendation,
# and any failure (missing config, timeout, error, malformed response)
# silently falls back to the deterministic answer.
#
# Leave RA_ASSISTANT_LLM_ENABLED unset or "false" to keep the assistant
# fully offline (the default, and the only mode required for Part 6).
#
# Never commit a real API key. This file is tracked by git; your actual
# .env file is not (see .gitignore).
RA_ASSISTANT_LLM_ENABLED=false
RA_ASSISTANT_LLM_BASE_URL=
RA_ASSISTANT_LLM_API_KEY=
RA_ASSISTANT_LLM_MODEL=
RA_ASSISTANT_LLM_TIMEOUT_SECONDS=5
